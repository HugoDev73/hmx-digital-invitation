---
import Button from '../ui/Button.astro';
import { event } from '../../data/event';
import { icsHref, googleCalendarHref } from '../../lib/calendar';
---

<section class="closing">
  <div class="u-divider" aria-hidden="true"></div>
  <p class="closing__text">{event.closing}</p>
  <p class="closing__signature">{event.celebrant}</p>

  <div class="closing__actions">
    <!-- No `download` attribute: iOS (including WhatsApp's in-app browser)
         opens a served .ics as an "Add to Calendar" sheet, but ignores a
         download link. -->
    <Button href={icsHref} label="Agregar al calendario" variant="solid">
      <svg
        slot="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="4" width="18" height="18" rx="2"></rect>
        <path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4"></path>
      </svg>
    </Button>
    <a class="u-link" href={googleCalendarHref} target="_blank" rel="noopener noreferrer">
      o agrégalo en Google Calendar
    </a>
  </div>

  <img
    src="/bouquet.webp"
    alt=""
    aria-hidden="true"
    class="closing__bouquet"
    width="240"
    height="240"
    loading="lazy"
    decoding="async"
  />
</section>

<style>
  .closing {
    position: relative;
    text-align: center;
    padding: 2rem 1.5rem 9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .closing .u-divider {
    margin: 0 auto 1.75rem;
  }

  .closing__text {
    margin: 0;
    font-family: var(--font-title);
    font-size: 1.3125rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
    max-width: 22ch;
    text-wrap: balance;
  }

  /* Sign-off: the name returns at the end, echoing the hero. */
  .closing__signature {
    margin: 0.9rem 0 2rem;
    font-family: var(--font-title);
    font-size: clamp(1.75rem, 9vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--rose-strong);
    text-wrap: balance;
  }

  .closing__actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  /* Upright bouquet in the bottom-left corner — the diagonal partner of the
     rotated one hanging from the hero's top-right corner. */
  .closing__bouquet {
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(110px, 36vw, 156px);
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    pointer-events: none;
  }
</style>
