---
import { event } from '../../data/event';
---

<section class="closing">
  <div class="u-divider" aria-hidden="true"></div>
  <p class="closing__text">{event.closing}</p>
  <p class="closing__signature">{event.celebrant}</p>

  <img
    src="/bouquet.webp"
    alt=""
    aria-hidden="true"
    class="closing__bouquet"
    width="240"
    height="240"
    loading="lazy"
    decoding="async"
  />
</section>

<style>
  .closing {
    position: relative;
    text-align: center;
    padding: 2rem 1.5rem 9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .closing .u-divider {
    margin: 0 auto 1.75rem;
  }

  .closing__text {
    margin: 0;
    font-family: var(--font-title);
    font-size: 1.3125rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--ink);
    max-width: 22ch;
    text-wrap: balance;
  }

  /* Sign-off: the name returns at the end, echoing the hero. */
  .closing__signature {
    margin: 0.9rem 0 0;
    font-family: var(--font-title);
    font-size: clamp(1.75rem, 9vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--rose-strong);
    text-wrap: balance;
  }

  /* Upright bouquet in the bottom-left corner — the diagonal partner of the
     rotated one hanging from the hero's top-right corner. */
  .closing__bouquet {
    position: absolute;
    left: 0;
    bottom: 0;
    width: clamp(110px, 36vw, 156px);
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    pointer-events: none;
  }
</style>
