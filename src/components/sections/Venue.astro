---
import Button from '../ui/Button.astro';

type Props = {
  heading: string;
  time: string;
  venue: string;
  address: string;
  mapsQuery: string;
};

const { heading, time, venue, address, mapsQuery } = Astro.props;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`;
---

<section class="venue">
  <h2 class="u-heading">{heading}</h2>
  <div class="u-divider" aria-hidden="true"></div>
  <p class="venue__time">{time}</p>
  <p class="venue__name">{venue}</p>
  <p class="venue__address">{address}</p>
  <Button
    href={mapsUrl}
    label="Cómo llegar"
    variant="outline"
    target="_blank"
    ariaLabel={`Cómo llegar a ${venue} (abre Google Maps)`}
  >
    <svg
      slot="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0Z"></path>
      <circle cx="12" cy="10" r="3"></circle>
    </svg>
  </Button>
</section>

<style>
  .venue {
    text-align: center;
    padding: 2.5rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .venue .u-divider {
    margin: 14px auto 18px;
  }

  /* Rose-strong only at ≥24px bold (docs/spec-project.md section 3). */
  .venue__time {
    margin: 0;
    font-family: var(--font-title);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--rose-strong);
    font-variant-numeric: lining-nums;
  }

  /* The venue name is a fact guests must read in daylight: ink. */
  .venue__name {
    margin: 0.35rem 0 0;
    font-family: var(--font-title);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ink);
    text-wrap: balance;
  }

  .venue__address {
    margin: 0.5rem 0 1.25rem;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink);
    max-width: 28ch;
    text-wrap: balance;
  }
</style>
