---
import Button from '../ui/Button.astro';

type Props = {
  heading: string;
  time: string;
  venue: string;
  address: string;
  mapsQuery: string;
};

const { heading, time, venue, address, mapsQuery } = Astro.props;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(mapsQuery)}`;
---

<section class="venue">
  <p class="u-eyebrow">{heading}</p>
  <div class="u-divider" aria-hidden="true"></div>
  <p class="venue__time">{time}</p>
  <p class="venue__name">{venue}</p>
  <p class="venue__address">{address}</p>
  <Button href={mapsUrl} label="Cómo llegar" variant="outline" target="_blank">
    <svg
      slot="icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0Z"></path>
      <circle cx="12" cy="10" r="3"></circle>
    </svg>
  </Button>
</section>

<style>
  .venue {
    text-align: center;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .venue__time,
  .venue__name {
    margin: 0;
    font-family: var(--font-title);
    font-weight: 600;
    color: var(--rose-strong);
  }

  .venue__time {
    font-size: 1.6rem;
  }

  .venue__name {
    font-size: 1.25rem;
  }

  .venue__address {
    margin: 0 0 0.75rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink);
    max-width: 28ch;
  }
</style>
