---
import { event } from '../../data/event';

const { lead, names, follow } = event.parents;
---

<!-- No section heading: it reads as the continuation of the quote above,
     then leads into the date. -->
<section class="parents" aria-label="Mis papás">
  <p class="parents__lead">{lead}</p>
  <p class="parents__names">{names}</p>
  {follow && <p class="parents__follow">{follow}</p>}
</section>

<style>
  .parents {
    text-align: center;
    padding: 0 1.5rem 2.5rem;
  }

  .parents__lead {
    margin: 0 auto 0.6rem;
    max-width: 28ch;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink);
    text-wrap: balance;
  }

  .parents__follow {
    margin: 0.6rem auto 0;
    max-width: 28ch;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .parents__names {
    margin: 0 auto;
    max-width: 24ch;
    font-family: var(--font-title);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
</style>
