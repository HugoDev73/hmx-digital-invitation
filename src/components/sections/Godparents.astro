---
import { godparents } from '../../data/godparents';
---

<section class="godparents">
  <h2 class="u-heading">Padrinos</h2>
  <div class="u-divider" aria-hidden="true"></div>
  <ul class="godparents__list">
    {
      godparents.map((group) => (
        <li class="godparents__group">
          <p class="godparents__role">{group.role}</p>
          <p class="godparents__names">{group.names}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .godparents {
    text-align: center;
    padding: 2.5rem 1.5rem 2rem;
  }

  .godparents__list {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .godparents__role {
    margin: 0 0 0.3rem;
    font-family: var(--font-title);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  .godparents__names {
    margin: 0 auto;
    max-width: 30ch;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ink);
    text-wrap: balance;
  }
</style>
