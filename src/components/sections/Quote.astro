---
import { event } from '../../data/event';
---

<section class="quote">
  <p class="quote__text">“{event.quote}”</p>
</section>

<style>
  /* Sentence case, italic and quoted (the spec's "caja baja" read as typos).
     Weight 400 keeps the italic line legible on a phone in daylight. */
  .quote {
    padding: 0.5rem 2rem 2.5rem;
    text-align: center;
  }

  .quote__text {
    margin: 0 auto;
    max-width: 30ch;
    font-family: var(--font-body);
    font-weight: 400;
    font-style: italic;
    font-size: 1.125rem;
    line-height: 1.8;
    text-wrap: pretty;
    color: var(--ink);
  }
</style>
