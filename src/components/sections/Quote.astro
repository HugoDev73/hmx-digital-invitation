---
import { event } from '../../data/event';
---

<section class="quote">
  <p class="quote__text">{event.quote}</p>
</section>

<style>
  .quote {
    padding: 0.5rem 2rem 1.5rem;
    text-align: center;
  }

  .quote__text {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 1.05rem;
    line-height: 1.9;
    letter-spacing: 0.01em;
    text-transform: lowercase;
    color: var(--ink);
  }
</style>
