---
import Button from '../ui/Button.astro';
import { event } from '../../data/event';

const routeUrl = `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(
  event.ceremony.mapsQuery
)}&destination=${encodeURIComponent(event.reception.mapsQuery)}`;
---

<section class="between-venues">
  <div class="between-venues__card">
    <svg
      class="between-venues__icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7v5l3 2"></path>
    </svg>
    <p class="between-venues__text">
      Solo <strong>5 minutos</strong> de la iglesia al salón.<br />
      Sal con tiempo tras la ceremonia.
    </p>
    <Button href={routeUrl} label="Ver ruta iglesia → salón" variant="outline" target="_blank">
      <svg
        slot="icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 8 22 12 18 16"></path>
        <path d="M2 12h20"></path>
        <path d="M6 16 2 12 6 8"></path>
      </svg>
    </Button>
  </div>
</section>

<style>
  .between-venues {
    padding: 1rem 1.5rem 2rem;
  }

  .between-venues__card {
    background: color-mix(in srgb, var(--rose-soft) 35%, var(--bg));
    border-radius: 16px;
    padding: 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .between-venues__icon {
    width: 26px;
    height: 26px;
    color: var(--rose-strong);
  }

  .between-venues__text {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink);
  }

  .between-venues__text strong {
    font-weight: 600;
  }
</style>
