---
import { event } from '../../data/event';

const { style, note } = event.dressCode;
---

<section class="dress-code">
  <h2 class="u-heading">Código de vestimenta</h2>
  <div class="u-divider" aria-hidden="true"></div>
  {style && <p class="dress-code__style">{style}</p>}
  {note && <p class="dress-code__note">{note}</p>}
</section>

<style>
  /* Same rhythm and type as the Padrinos section: the style line mirrors
     .godparents__role and the note mirrors .godparents__names. */
  .dress-code {
    text-align: center;
    padding: 2.5rem 1.5rem 2rem;
  }

  .dress-code__style {
    margin: 1.25rem 0 0.3rem;
    font-family: var(--font-title);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--ink);
  }

  .dress-code__note {
    margin: 0 auto;
    max-width: 30ch;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--ink);
    text-wrap: balance;
  }
</style>
