---
import { event } from '../../data/event';
---

<section class="hero">
  <img
    src="/bouquet.webp"
    alt=""
    aria-hidden="true"
    class="hero__bouquet"
    width="240"
    height="240"
    loading="eager"
    decoding="async"
  />

  <p class="u-eyebrow hero__eyebrow">{event.title}</p>
  <h1 class="hero__name">{event.celebrant}</h1>
  <div class="u-divider hero__divider" aria-hidden="true"></div>

  <img
    src="/celebrant.webp"
    alt={`Ilustración de ${event.celebrant} de espaldas, con vestido de XV años rosa y flores en el cabello`}
    class="hero__celebrant"
    width="640"
    height="960"
    loading="eager"
    fetchpriority="high"
  />
</section>

<style>
  /* Entrance order follows docs/spec-project.md section 9:
     eyebrow → bouquet → name → divider → illustration. */
  .hero {
    position: relative;
    text-align: center;
    padding: 4rem 1.5rem 0;
  }

  .hero__bouquet {
    position: absolute;
    top: 0;
    right: 0;
    width: clamp(96px, 32vw, 140px);
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    /* The source bouquet fills a bottom-left corner; rotated it hangs from
       the top-right corner. The closing section uses it upright. */
    transform: rotate(180deg);
    animation: bouquet-in 0.9s var(--ease-out) 0.12s both;
  }

  .hero__eyebrow {
    position: relative;
    animation: fade-up 0.9s var(--ease-out) both;
  }

  /* max-inline-size keeps the name stacked on two lines at every width,
     so the desktop card never runs it into the bouquet. */
  .hero__name {
    position: relative;
    margin: 1.25rem auto 0;
    max-inline-size: 7em;
    font-family: var(--font-title);
    font-size: clamp(2.25rem, 14vw, 3.5rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: 0.02em;
    color: var(--rose-strong);
    text-wrap: balance;
    overflow-wrap: anywhere;
    animation: fade-up 0.9s var(--ease-out) 0.28s both;
  }

  .hero__divider {
    margin: 1.25rem auto 0.5rem;
    animation: fade-up 0.9s var(--ease-out) 0.44s both;
  }

  .hero__celebrant {
    width: min(80%, 320px);
    height: auto;
    margin: 0 auto;
    -webkit-mask-image: linear-gradient(to bottom, black 78%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 78%, transparent 100%);
    animation: portrait-in 1.4s var(--ease-out) 0.56s both;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes bouquet-in {
    from {
      opacity: 0;
      transform: translateY(-10px) rotate(180deg);
    }
  }

  @keyframes portrait-in {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(6px);
    }
  }
</style>
