---
import '@fontsource/cinzel/400.css';
import '@fontsource/cinzel/500.css';
import '@fontsource/cinzel/600.css';
import '@fontsource/cinzel/700.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/utilities.css';
import { event } from '../data/event';
import { godparentsArePlaceholder } from '../data/godparents';

type Props = {
  title?: string;
  description?: string;
};

const {
  title = `XV Años de ${event.celebrant} · ${event.date.day} ${event.date.month.slice(0, 3)} ${event.date.year}`,
  description = 'Acompáñanos a celebrar. Toca para ver los detalles.',
} = Astro.props;

// WhatsApp needs an absolute og:image URL, so it is built from Astro.site
// (astro.config.mjs). Until the deploy target is decided, the build warns.
const ogImage = Astro.site ? new URL('/og.jpg', Astro.site).href : '/og.jpg';

if (import.meta.env.PROD) {
  const pending = [
    !Astro.site && '`site` in astro.config.mjs (absolute og:image URL for WhatsApp)',
    event.whatsappIsPlaceholder && 'WhatsApp number (src/data/event.ts)',
    godparentsArePlaceholder && 'godparent names (src/data/godparents.ts)',
  ].filter(Boolean);
  if (pending.length > 0) {
    console.warn(`\n⚠️  Placeholder data still in the build:\n  - ${pending.join('\n  - ')}\n`);
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F7F1E8" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Invitación a los XV Años de ${event.celebrant}`} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/celebrant.webp" as="image" type="image/webp" fetchpriority="high" />
  </head>
  <body>
    <div class="u-shell">
      <div class="u-petals" id="petals" aria-hidden="true"></div>
      <div class="u-content">
        <slot />
      </div>
    </div>
  </body>
</html>

<script>
  // Subtle falling-petals background — see docs/spec-project.md section 9.
  // Skipped entirely under prefers-reduced-motion, not just paused via CSS.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const wrap = document.getElementById('petals');
    if (wrap instanceof HTMLElement) {
      const styles = getComputedStyle(document.documentElement);
      const colors = [
        styles.getPropertyValue('--rose-soft').trim(),
        styles.getPropertyValue('--rose').trim(),
      ];
      const count = 9;

      for (let i = 0; i < count; i++) {
        const petal = document.createElement('div');
        petal.className = 'u-petal';
        const size = 9 + Math.random() * 10;
        petal.style.width = `${size}px`;
        petal.style.height = `${size}px`;
        petal.style.left = `${Math.random() * 100}%`;
        petal.style.animationDuration = `${9 + Math.random() * 7}s`;
        petal.style.animationDelay = `${-Math.random() * 12}s`;
        const color = colors[i % colors.length];
        petal.innerHTML = `<svg viewBox="0 0 24 24" fill="${color}"><path d="M12 3c3 2 5 5 5 8 0 4-2.5 7-5 10-2.5-3-5-6-5-10 0-3 2-6 5-8Z" opacity=".85"/></svg>`;
        wrap.appendChild(petal);
      }
    }
  }
</script>

<style>
  .u-content {
    position: relative;
    z-index: 1;
  }

  .u-petals {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .u-petals :global(.u-petal) {
    position: absolute;
    top: -24px;
    opacity: 0;
    animation: petal-fall linear infinite;
  }

  .u-petals :global(.u-petal svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @keyframes petal-fall {
    0% {
      transform: translateY(-30px) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 0.55;
    }
    90% {
      opacity: 0.5;
    }
    100% {
      transform: translateY(115vh) rotate(320deg);
      opacity: 0;
    }
  }
</style>
