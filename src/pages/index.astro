---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Quote from '../components/sections/Quote.astro';
import EventDate from '../components/sections/EventDate.astro';
import Countdown from '../components/sections/Countdown.astro';
import Venue from '../components/sections/Venue.astro';
import BetweenVenues from '../components/sections/BetweenVenues.astro';
import Godparents from '../components/sections/Godparents.astro';
import Contact from '../components/sections/Contact.astro';
import Closing from '../components/sections/Closing.astro';
import { event } from '../data/event';
---

<Base>
  <Hero />
  <Quote />
  <EventDate />
  <Countdown />
  <Venue
    heading="Ceremonia"
    time={event.ceremony.time}
    venue={event.ceremony.venue}
    address={event.ceremony.address}
    mapsQuery={event.ceremony.mapsQuery}
  />
  <Venue
    heading="Recepción"
    time={event.reception.time}
    venue={event.reception.venue}
    address={event.reception.address}
    mapsQuery={event.reception.mapsQuery}
  />
  <BetweenVenues />
  <Godparents />
  <Contact />
  <Closing />
</Base>
